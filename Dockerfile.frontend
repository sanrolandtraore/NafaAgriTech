# =============================================================================
# NAFA-AGRITECH — FRONTEND SAAS CLIENT (VITE + REACT + NGINX)
# =============================================================================
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Construction de la distribution optimisée pour production
RUN npm run build

# Stage 2 : Nginx pour distribution statique et reverse-proxying API
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
